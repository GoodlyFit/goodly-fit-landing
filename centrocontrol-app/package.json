{
  "name": "goodly-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && prisma db push --skip-generate && node prisma/seed.mjs --si-vacia && next build",
    "start": "next start -p 3000",
    "db:setup": "prisma db push && node prisma/seed.mjs",
    "db:reset": "prisma db push --force-reset && node prisma/seed.mjs",
    "usuario": "node scripts/crear-usuario.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}